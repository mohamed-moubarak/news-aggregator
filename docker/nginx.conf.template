# Rendered to /etc/nginx/conf.d/default.conf at startup by the nginx image's
# envsubst step; only the *_API_KEY variables are substituted.

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # ---- API proxy: same paths as the Vite dev server (vite.config.ts) --------
  # Keys are added here, server-side. Upstream hosts are fixed, so the proxy
  # can't be used to reach arbitrary URLs.

  location /api/guardian/ {
    rewrite ^/api/guardian/(.*)$ /$1?api-key=${GUARDIAN_API_KEY} break;
    proxy_pass https://content.guardianapis.com;
    proxy_set_header Host content.guardianapis.com;
    proxy_ssl_server_name on;
  }

  location /api/nyt/ {
    rewrite ^/api/nyt/(.*)$ /svc/search/v2/$1?api-key=${NYT_API_KEY} break;
    proxy_pass https://api.nytimes.com;
    proxy_set_header Host api.nytimes.com;
    proxy_ssl_server_name on;
  }

  location /api/newsapi/ {
    rewrite ^/api/newsapi/(.*)$ /v2/$1 break;
    proxy_pass https://newsapi.org;
    proxy_set_header Host newsapi.org;
    proxy_set_header X-Api-Key ${NEWSAPI_API_KEY};
    proxy_ssl_server_name on;
  }

  # ---- Static app ----------------------------------------------------------

  # Hashed build assets never change: cache them for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }

  # Client-side routes (/explore, /you, …) fall back to the SPA shell,
  # which must always be revalidated so new deploys are picked up.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
  }
}
